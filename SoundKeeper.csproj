<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>SoundKeeper</AssemblyName>
    <RootNamespace>SoundKeeper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>SoundKeeper</Product>
    <Description>Keeps Bluetooth audio devices awake by continuously playing an inaudible audio stream.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 单文件发布时压缩内嵌程序集，显著减小体积（约 103MB → 约 47MB）。
         注意：压缩仅支持自包含（self-contained）发布，框架依赖模式下会报
         NETSDK1176，因此这里必须加 SelfContained 条件。
         代价：启动时需将程序集解压到内存，冷启动略慢。 -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
